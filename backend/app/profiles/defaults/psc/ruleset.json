  "track_rules": [
    {
      "id": "t1",
      "description": "An individual PSC or beneficial owner is a person",
      "when": [
        {
          "column": "kind",
          "op": "in",
          "values": [
            "individual-person-with-significant-control",
            "individual-beneficial-owner"
          ]
        }
      ],
      "track": "person"
    },
    {
      "id": "t2",
      "description": "A corporate entity or legal person is an organisation",
      "when": [
        {
          "column": "kind",
          "op": "in",
          "values": [
            "corporate-entity-person-with-significant-control",
            "corporate-entity-beneficial-owner",
            "legal-person-person-with-significant-control",
            "legal-person-beneficial-owner"
          ]
        }
      ],
      "track": "organisation"
    },
    {
      "id": "t3",
      "description": "Anything with a parsed surname is a person",
      "when": [
        {
          "column": "surname",
          "op": "not_null"
        }
      ],
      "track": "person"
    }
  ],
  "default_track": "organisation",
  "cleaning": {
    "person": [
      {
        "id": "p1",
        "description": "Surname as filed, upper-cased",
        "op": "upper",
        "source": "surname",
        "target": "surname_clean"
      },
      {
        "id": "p2",
        "description": "Fold accents so L\u00d6WE and LOWE meet",
        "op": "accent_fold",
        "source": "surname_clean",
        "target": "surname_clean"
      },
      {
        "id": "p3",
        "description": "A surname that is only a filler word is missing",
        "op": "nullify",
        "source": "surname_clean",
        "target": "surname_clean",
        "lists": [
          "fake_nulls"
        ]
      },
      {
        "id": "p4",
        "description": "A surname that is only a title is missing",
        "op": "nullify",
        "source": "surname_clean",
        "target": "surname_clean",
        "lists": [
          "person_titles"
        ]
      },
      {
        "id": "p5",
        "description": "Forename upper-cased",
        "op": "upper",
        "source": "forename",
        "target": "forename_clean"
      },
      {
        "id": "p6",
        "description": "Fold accents",
        "op": "accent_fold",
        "source": "forename_clean",
        "target": "forename_clean"
      },
      {
        "id": "p7",
        "description": "A forename that is only a filler word is missing",
        "op": "nullify",
        "source": "forename_clean",
        "target": "forename_clean",
        "lists": [
          "fake_nulls"
        ]
      },
      {
        "id": "p8",
        "description": "A forename that is only a title is missing",
        "op": "nullify",
        "source": "forename_clean",
        "target": "forename_clean",
        "lists": [
          "person_titles"
        ]
      },
      {
        "id": "p9",
        "description": "Map a diminutive to its canonical forename",
        "op": "lookup",
        "source": "forename_clean",
        "target": "forename_canon",
        "table": "nicknames",
        "scope": "value"
      },
      {
        "id": "p10",
        "description": "Middle names upper-cased",
        "op": "upper",
        "source": "middle_name",
        "target": "middle_clean"
      },
      {
        "id": "p11",
        "description": "Fold accents",
        "op": "accent_fold",
        "source": "middle_clean",
        "target": "middle_clean"
      },
      {
        "id": "p12",
        "description": "A middle name that is only a filler word is missing",
        "op": "nullify",
        "source": "middle_clean",
        "target": "middle_clean",
        "lists": [
          "fake_nulls"
        ]
      },
      {
        "id": "p13",
        "description": "Phonetic key of the surname, for blocking",
        "op": "function",
        "name": "metaphone",
        "source": "surname_clean",
        "target": "surname_metaphone"
      },
      {
        "id": "p14",
        "description": "Phonetic key of the canonical forename",
        "op": "function",
        "name": "metaphone",
        "source": "forename_canon",
        "target": "forename_metaphone"
      },
      {
        "id": "p15",
        "description": "First letter of the canonical forename",
        "op": "function",
        "name": "initials",
        "source": "forename_canon",
        "target": "forename_initial"
      },
      {
        "id": "p16",
        "description": "Sorted distinct letters of forename and surname, so a middle name on one side only does not break the key",
        "op": "concat",
        "sources": [
          "forename_canon",
          "surname_clean"
        ],
        "separator": " ",
        "require_all": false,
        "target": "name_fingerprint"
      },
      {
        "id": "p17",
        "description": "Sorted tokens of that",
        "op": "function",
        "name": "sorted_tokens",
        "source": "name_fingerprint",
        "target": "name_fingerprint"
      },
      {
        "id": "p18",
        "description": "Nationality, first one listed, home nations collapsed",
        "op": "lookup",
        "source": "nationality",
        "target": "nationality_norm",
        "table": "nationalities",
        "scope": "value"
      },
      {
        "id": "p19",
        "description": "Country of residence, home nations collapsed",
        "op": "lookup",
        "source": "country_of_residence",
        "target": "residence_norm",
        "table": "residences",
        "scope": "value"
      },
      {
        "id": "p20",
        "description": "Postcode as 'OUTWARD INWARD'",
        "op": "function",
        "name": "normalise_postcode",
        "source": "postcode",
        "target": "postcode_clean"
      },
      {
        "id": "p21",
        "description": "A postcode used by thousands of records is a formation agent's office, not where anybody lives",
        "op": "nullify",
        "source": "postcode_clean",
        "target": "postcode_clean",
        "lists": [
          "junk_postcodes"
        ]
      },
      {
        "id": "p22",
        "description": "Postcode district, for blocking",
        "op": "function",
        "name": "postcode_district",
        "source": "postcode_clean",
        "target": "postcode_district"
      },
      {
        "id": "p23",
        "description": "A birth year later than 16 years ago, or before 1890, is a copied filing date or a redaction sentinel",
        "op": "nullify_outside_range",
        "source": "dob_year",
        "target": "dob_year_clean",
        "min": 1890,
        "max_years_ago": 16
      },
      {
        "id": "p24",
        "description": "The month only counts when the year does",
        "op": "copy",
        "source": "dob_month",
        "target": "dob_month_clean"
      },
      {
        "id": "p25",
        "description": "Address line, upper-cased, for the over-merge split",
        "op": "upper",
        "source": "address_line_1",
        "target": "address_line_clean"
      },
      {
        "id": "p26",
        "description": "A filler address line corroborates nothing",
        "op": "nullify",
        "source": "address_line_clean",
        "target": "address_line_clean",
        "lists": [
          "fake_nulls"
        ]
      },
      {
        "id": "p27",
        "description": "Address line and town as one key: a street number means an address only beside its town",
        "op": "concat",
        "sources": [
          "address_line_clean",
          "locality"
        ],
        "separator": " | ",
        "target": "address_key"
      }
    ],
    "organisation": [
      {
        "id": "o1",
        "description": "Name upper-cased",
        "op": "upper",
        "source": "name",
        "target": "name_clean"
      },
      {
        "id": "o2",
        "description": "Fold accents",
        "op": "accent_fold",
        "source": "name_clean",
        "target": "name_clean"
      },
      {
        "id": "o3",
        "description": "Spell out the ampersand",
        "op": "regex_replace",
        "source": "name_clean",
        "target": "name_clean",
        "pattern": "\\s*&\\s*",
        "replacement": " AND "
      },
      {
        "id": "o4",
        "description": "Drop anything in brackets \u2014 it is a note, not the name",
        "op": "regex_replace",
        "source": "name_clean",
        "target": "name_clean",
        "pattern": "\\([^)]*\\)",
        "replacement": " "
      },
      {
        "id": "o5",
        "description": "Drop punctuation",
        "op": "strip_punctuation",
        "source": "name_clean",
        "target": "name_clean",
        "keep": " "
      },
      {
        "id": "o6",
        "description": "Collapse repeated spaces",
        "op": "collapse_spaces",
        "source": "name_clean",
        "target": "name_clean"
      },
      {
        "id": "o7",
        "description": "A name that is only a filler word is missing",
        "op": "nullify",
        "source": "name_clean",
        "target": "name_clean",
        "lists": [
          "fake_nulls"
        ]
      },
      {
        "id": "o8",
        "description": "Drop a leading 'TRUSTEES OF THE'",
        "op": "regex_replace",
        "source": "name_clean",
        "target": "name_clean",
        "pattern": "^TRUSTEES? OF (THE )?",
        "replacement": ""
      },
      {
        "id": "o9",
        "description": "Drop a leading 'THE'",
        "op": "strip_tokens",
        "source": "name_clean",
        "target": "name_clean",
        "lists": [
          "leading_articles"
        ],
        "position": "leading",
        "repeat": true
      },
      {
        "id": "o10",
        "description": "Drop a leading personal title",
        "op": "strip_tokens",
        "source": "name_clean",
        "target": "name_clean",
        "lists": [
          "person_titles"
        ],
        "position": "leading",
        "repeat": true
      },
      {
        "id": "o11",
        "description": "Split the legal form off the end, keeping it",
        "op": "strip_tokens",
        "source": "name_clean",
        "target": "name_core",
        "lists": [
          "legal_forms"
        ],
        "position": "trailing",
        "repeat": true,
        "keep_as": "legal_form_clean"
      },
      {
        "id": "o12",
        "description": "Sorted distinct words of the core name",
        "op": "function",
        "name": "sorted_tokens",
        "source": "name_core",
        "target": "name_tokens_sorted"
      },
      {
        "id": "o13",
        "description": "First word of the core name, for blocking",
        "op": "function",
        "name": "first_token",
        "source": "name_core",
        "target": "name_first_token"
      },
      {
        "id": "o14",
        "description": "Phonetic key of the core name",
        "op": "function",
        "name": "metaphone",
        "source": "name_core",
        "target": "name_core_metaphone"
      },
      {
        "id": "o15",
        "description": "Registration number, punctuation and padding fixed",
        "op": "function",
        "name": "normalise_company_number",
        "source": "registration_number",
        "target": "regnum_clean"
      },
      {
        "id": "o16",
        "description": "A placeholder number names no company",
        "op": "nullify",
        "source": "regnum_clean",
        "target": "regnum_clean",
        "lists": [
          "placeholder_numbers"
        ]
      },
      {
        "id": "o17",
        "description": "Country of registration, upper-cased",
        "op": "upper",
        "source": "country_registered",
        "target": "country_canonical"
      },
      {
        "id": "o17b",
        "description": "Spell out the ampersand before punctuation goes, or 'England & Wales' becomes 'ENGLAND WALES' and misses the map (it does exactly that in the prior art)",
        "op": "regex_replace",
        "source": "country_canonical",
        "target": "country_canonical",
        "pattern": "\\s*&\\s*",
        "replacement": " AND "
      },
      {
        "id": "o18",
        "description": "Drop punctuation from the country",
        "op": "strip_punctuation",
        "source": "country_canonical",
        "target": "country_canonical",
        "keep": " "
      },
      {
        "id": "o19",
        "description": "Collapse spaces",
        "op": "collapse_spaces",
        "source": "country_canonical",
        "target": "country_canonical"
      },
      {
        "id": "o20",
        "description": "Canonical country code",
        "op": "lookup",
        "source": "country_canonical",
        "target": "country_canonical",
        "table": "countries",
        "scope": "value"
      },
      {
        "id": "o21",
        "description": "Postcode as 'OUTWARD INWARD'",
        "op": "function",
        "name": "normalise_postcode",
        "source": "postcode",
        "target": "postcode_clean"
      },
      {
        "id": "o22",
        "description": "A formation agent's postcode is not an address",
        "op": "nullify",
        "source": "postcode_clean",
        "target": "postcode_clean",
        "lists": [
          "junk_postcodes"
        ]
      },
      {
        "id": "o23",
        "description": "Postcode district",
        "op": "function",
        "name": "postcode_district",
        "source": "postcode_clean",
        "target": "postcode_district"
      },
      {
        "id": "o24",
        "description": "Address line upper-cased",
        "op": "upper",
        "source": "address_line_1",
        "target": "address_line_clean"
      },
      {
        "id": "o25",
        "description": "Every organisation starts as OTHER; the type rules below move the ones they recognise",
        "op": "regex_replace",
        "source": "name_clean",
        "target": "type_bucket_default",
        "pattern": "^.+$",
        "replacement": "OTHER"
      }
    ]
  },
  "derived_columns": [
    {
      "id": "d1",
      "target": "type_bucket",
      "description": "What kind of body this is, from words in the name. A trust, a government body, a school or a charity outranks every legal form, so SMITH FAMILY TRUST LIMITED is a TRUST.",
      "default_from": "type_bucket_default",
      "tracks": [
        "organisation"
      ],
      "rules": [
        {
          "id": "d1r1",
          "description": "A will, settlement, estate, fund or foundation is a trust",
          "when": [
            {
              "column": "name_clean",
              "op": "matches",
              "pattern": "\\b(WILL TRUST|DISCRETIONARY TRUST|FAMILY TRUST|LIFE SETTLEMENT|ESTATE OF|TRUST|SETTLEMENT|FUND|FOUNDATION)\\b"
            }
          ],
          "value": "TRUST"
        },
        {
          "id": "d1r2",
          "description": "A ministry, council or agency is government",
          "when": [
            {
              "column": "name_clean",
              "op": "matches",
              "pattern": "\\b(GOVERNMENT|MINISTRY|MINISTER|DEPARTMENT|COUNCIL|AUTHORITY|MUNICIPALITY|BOROUGH|COUNTY|CITY OF|STATE ADMINISTRATION|COMMISSION|AGENCY|OFFICE OF)\\b"
            }
          ],
          "value": "GOVT"
        },
        {
          "id": "d1r3",
          "description": "A university, college or school is education",
          "when": [
            {
              "column": "name_clean",
              "op": "matches",
              "pattern": "\\b(UNIVERSITY|COLLEGE|SCHOOL|INSTITUTE|FACULTY|ACADEMY)\\b"
            }
          ],
          "value": "EDU"
        },
        {
          "id": "d1r4",
          "description": "A charity, association, society or church",
          "when": [
            {
              "column": "name_clean",
              "op": "matches",
              "pattern": "\\b(CHARITY|ASSOCIATION|SOCIETY|CHURCH|FEDERATION|UNION)\\b"
            }
          ],
          "value": "CHARITY"
        },
        {
          "id": "d1r5",
          "description": "A public limited company",
          "when": [
            {
              "column": "name_clean",
              "op": "matches",
              "pattern": "\\b(PLC|PUBLIC LIMITED COMPANY)\\b"
            }
          ],
          "value": "PLC"
        },
        {
          "id": "d1r6",
          "description": "A limited liability partnership",
          "when": [
            {
              "column": "name_clean",
              "op": "matches",
              "pattern": "\\b(LLP|LIMITED LIABILITY PARTNERSHIP)\\b"
            }
          ],
          "value": "LLP"
        },
        {
          "id": "d1r7",
          "description": "A limited liability company",
          "when": [
            {
              "column": "name_clean",
              "op": "matches",
              "pattern": "\\b(LLC|LIMITED LIABILITY COMPANY)\\b"
            }
          ],
          "value": "LLC"
        },
        {
          "id": "d1r8",
          "description": "A limited partnership",
          "when": [
            {
              "column": "name_clean",
              "op": "matches",
              "pattern": "\\b(LP|LIMITED PARTNERSHIP)\\b"
            }
          ],
          "value": "LP"
        },
        {
          "id": "d1r9",
          "description": "A German GmbH",
          "when": [
            {
              "column": "name_clean",
              "op": "matches",
              "pattern": "\\bGMBH\\b"
            }
          ],
          "value": "GMBH"
        },
        {
          "id": "d1r10",
          "description": "An incorporated company",
          "when": [
            {
              "column": "name_clean",
              "op": "matches",
              "pattern": "\\b(INC|INCORPORATED|CORPORATION|CORP)\\b"
            }
          ],
          "value": "INC"
        },
        {
          "id": "d1r11",
          "description": "A private limited company",
          "when": [
            {
              "column": "name_clean",
              "op": "matches",
              "pattern": "\\b(LIMITED|LTD)\\b"
            }
          ],
          "value": "LTD"
        }
      ]
    }
  ],
  "match_keys": [
    {
      "id": "k1",
      "name": "Person: name and date of birth",
      "track": "person",
      "tier": 1,
      "description": "deduping's stage 1 key plus its stage 1.5 split. Surname, canonical forename and both parts of the date of birth, none of them missing. The corroborators are the split: a group this size that shares no address and no company is several people with one name, not one person.",
      "columns": [
        "surname_clean",
        "forename_canon",
        "dob_year_clean",
        "dob_month_clean"
      ],
      "allow_null": false,
      "applies_when": "always",
      "guards": {
        "max_group_size": 30,
        "require_any_equal": [
          "postcode_clean",
          "company_number",
          "address_key"
        ]
      },
      "on_guard_fail": "review"
    },
    {
      "id": "k2",
      "name": "Organisation: country and registration number",
      "track": "organisation",
      "tier": 1,
      "description": "The registration number names the company itself, so with the country it is the strongest key there is. Placeholder numbers are blocked, and a number carrying more than three different names is a formation agent's, not a company's.",
      "columns": [
        "country_canonical",
        "regnum_clean"
      ],
      "allow_null": false,
      "applies_when": "always",
      "guards": {
        "blocklists": [
          "placeholder_numbers"
        ],
        "max_distinct": {
          "column": "name_core",
          "count": 3
        },
        "max_group_size": 50
      },
      "on_guard_fail": "review"
    },
    {
      "id": "k3",
      "name": "Organisation: core name and type",
      "track": "organisation",
      "tier": 2,
      "description": "For the records the number could not key. Raw name prefixes once collapsed 1,800 unrelated trusts, so the whole core name and the type bucket are the empirically safe key.",
      "columns": [
        "name_core",
        "type_bucket"
      ],
      "allow_null": false,
      "applies_when": "no_earlier_key",
      "guards": {
        "max_group_size": 50
      },
      "on_guard_fail": "review"
    }
  ],
  "vetoes": []
}
