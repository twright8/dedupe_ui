  "track_rules": [
    {
      "id": "t1",
      "description": "An Individual donor is a person",
      "when": [
        {
          "column": "donor_status",
          "op": "equals",
          "value": "Individual"
        }
      ],
      "track": "person"
    },
    {
      "id": "t2",
      "description": "An ambiguous donor whose name starts with a title is a person",
      "when": [
        {
          "column": "donor_status",
          "op": "in",
          "values": [
            "Impermissible Donor",
            "Other"
          ]
        },
        {
          "column": "name",
          "op": "starts_with_token",
          "lists": [
            "person_titles"
          ]
        }
      ],
      "track": "person"
    },
    {
      "id": "t3",
      "description": "An ambiguous donor whose name carries a legal form or an organisation word is an organisation",
      "when": [
        {
          "column": "donor_status",
          "op": "in",
          "values": [
            "Impermissible Donor",
            "Other"
          ]
        },
        {
          "column": "name",
          "op": "contains_token",
          "lists": [
            "legal_forms",
            "org_words"
          ]
        }
      ],
      "track": "organisation"
    },
    {
      "id": "t4",
      "description": "Any other Impermissible Donor is a person",
      "when": [
        {
          "column": "donor_status",
          "op": "equals",
          "value": "Impermissible Donor"
        }
      ],
      "track": "person"
    }
  ],
  "default_track": "organisation",
  "cleaning": {
    "person": [
      {
        "id": "p1",
        "description": "Upper-case the name",
        "op": "upper",
        "source": "name",
        "target": "name_clean"
      },
      {
        "id": "p2",
        "description": "Fold accents to plain letters",
        "op": "accent_fold",
        "source": "name_clean",
        "target": "name_clean"
      },
      {
        "id": "p3",
        "description": "Drop punctuation, keeping spaces and hyphens. Apostrophes go, so O'Neill, O’Neill and ONeill become one spelling",
        "op": "strip_punctuation",
        "source": "name_clean",
        "target": "name_clean",
        "keep": " -"
      },
      {
        "id": "p4",
        "description": "Collapse repeated spaces",
        "op": "collapse_spaces",
        "source": "name_clean",
        "target": "name_clean"
      },
      {
        "id": "p5",
        "description": "A name that is only a null spelling is missing",
        "op": "nullify",
        "source": "name_clean",
        "target": "name_clean",
        "lists": [
          "null_values"
        ]
      },
      {
        "id": "p6",
        "description": "Remove leading titles, keeping them in title",
        "op": "strip_tokens",
        "source": "name_clean",
        "target": "name_clean",
        "lists": [
          "person_titles"
        ],
        "position": "leading",
        "repeat": true,
        "keep_as": "title"
      },
      {
        "id": "p7",
        "description": "Remove trailing post-nominals, keeping them in post_nominals",
        "op": "strip_tokens",
        "source": "name_clean",
        "target": "name_clean",
        "lists": [
          "post_nominals"
        ],
        "position": "trailing",
        "repeat": true,
        "keep_as": "post_nominals"
      },
      {
        "id": "p8",
        "description": "Split the name into forename, middle names and surname",
        "op": "function",
        "name": "parse_person_name",
        "source": "name_clean"
      },
      {
        "id": "p9",
        "description": "Map a diminutive forename to its canonical form",
        "op": "lookup",
        "source": "forename",
        "target": "forename_canon",
        "table": "nicknames",
        "scope": "value"
      },
      {
        "id": "p10",
        "description": "Phonetic key for the surname",
        "op": "function",
        "name": "metaphone",
        "source": "surname",
        "target": "surname_metaphone"
      }
    ],
    "organisation": [
      {
        "id": "o1",
        "description": "Upper-case the name",
        "op": "upper",
        "source": "name",
        "target": "name_clean"
      },
      {
        "id": "o2",
        "description": "Fold accents to plain letters",
        "op": "accent_fold",
        "source": "name_clean",
        "target": "name_clean"
      },
      {
        "id": "o3",
        "description": "Spell out the ampersand, so 'Smith & Son' and 'Smith and Son' agree",
        "op": "regex_replace",
        "source": "name_clean",
        "target": "name_clean",
        "pattern": "&",
        "replacement": " AND "
      },
      {
        "id": "o4",
        "description": "Drop punctuation",
        "op": "strip_punctuation",
        "source": "name_clean",
        "target": "name_clean",
        "keep": " "
      },
      {
        "id": "o5",
        "description": "Collapse repeated spaces",
        "op": "collapse_spaces",
        "source": "name_clean",
        "target": "name_clean"
      },
      {
        "id": "o6",
        "description": "A name that is only a null spelling is missing",
        "op": "nullify",
        "source": "name_clean",
        "target": "name_clean",
        "lists": [
          "null_values"
        ]
      },
      {
        "id": "o7",
        "description": "Drop a leading 'THE'",
        "op": "strip_tokens",
        "source": "name_clean",
        "target": "name_clean",
        "lists": [
          "leading_articles"
        ],
        "position": "leading",
        "repeat": true
      },
      {
        "id": "o8",
        "description": "Split the legal form off the end of the name",
        "op": "strip_tokens",
        "source": "name_clean",
        "target": "name_core",
        "lists": [
          "legal_forms"
        ],
        "position": "trailing",
        "repeat": true,
        "keep_as": "legal_form"
      },
      {
        "id": "o9",
        "description": "Sorted distinct tokens, to catch a different word order",
        "op": "function",
        "name": "sorted_tokens",
        "source": "name_core",
        "target": "name_tokens_sorted"
      },
      {
        "id": "o10",
        "description": "Reformat the postcode",
        "op": "function",
        "name": "normalise_postcode",
        "source": "postcode",
        "target": "postcode_clean"
      },
      {
        "id": "o10a",
        "description": "A placeholder postcode means 'not known', so it becomes missing",
        "op": "nullify",
        "source": "postcode_clean",
        "target": "postcode_clean",
        "lists": [
          "placeholder_postcodes"
        ]
      },
      {
        "id": "o11",
        "description": "The postcode district, for blocking",
        "op": "function",
        "name": "postcode_district",
        "source": "postcode_clean",
        "target": "postcode_district"
      },
      {
        "id": "o12",
        "description": "Pad and tidy the company number",
        "op": "function",
        "name": "normalise_company_number",
        "source": "company_number",
        "target": "company_number_clean"
      },
      {
        "id": "o13",
        "description": "First word of the core name, for blocking (ACME of 'ACME TRADING')",
        "op": "function",
        "name": "first_token",
        "source": "name_core",
        "target": "name_first_token"
      }
    ]
  },
  "derived_columns": [
    {
      "id": "d1",
      "target": "donor_status_std",
      "description": "The donor status corrected from the company number. The Electoral Commission's status is often wrong at source: companies are filed as unincorporated associations and LLPs as companies. Only the five statuses that get confused with each other are overridable, so an incorporated political party stays a party.",
      "default_from": "donor_status",
      "tracks": [
        "organisation"
      ],
      "rules": [
        {
          "id": "d1r1",
          "description": "A company number starting OC, SO or NC belongs to a limited liability partnership",
          "when": [
            {
              "column": "company_number_clean",
              "op": "starts_with",
              "values": [
                "OC",
                "SO",
                "NC"
              ]
            },
            {
              "column": "donor_status",
              "op": "in",
              "values": [
                "Company",
                "Limited Liability Partnership",
                "Unincorporated Association",
                "Other",
                "Trust"
              ]
            }
          ],
          "value": "Limited Liability Partnership"
        },
        {
          "id": "d1r2",
          "description": "A company number starting IP or SP belongs to a registered society, which the Commission calls a friendly society",
          "when": [
            {
              "column": "company_number_clean",
              "op": "starts_with",
              "values": [
                "IP",
                "SP"
              ]
            },
            {
              "column": "donor_status",
              "op": "in",
              "values": [
                "Company",
                "Limited Liability Partnership",
                "Unincorporated Association",
                "Other",
                "Trust"
              ]
            }
          ],
          "value": "Friendly Society"
        },
        {
          "id": "d1r3",
          "description": "A company number starting SC or NI is a Scottish or Northern Irish company",
          "when": [
            {
              "column": "company_number_clean",
              "op": "starts_with",
              "values": [
                "SC",
                "NI"
              ]
            },
            {
              "column": "donor_status",
              "op": "in",
              "values": [
                "Company",
                "Limited Liability Partnership",
                "Unincorporated Association",
                "Other",
                "Trust"
              ]
            }
          ],
          "value": "Company"
        },
        {
          "id": "d1r4",
          "description": "A company number that is all digits is an England and Wales company",
          "when": [
            {
              "column": "company_number_clean",
              "op": "matches",
              "pattern": "^[0-9]"
            },
            {
              "column": "donor_status",
              "op": "in",
              "values": [
                "Company",
                "Limited Liability Partnership",
                "Unincorporated Association",
                "Other",
                "Trust"
              ]
            }
          ],
          "value": "Company"
        },
        {
          "id": "d1r5",
          "description": "A donor with a company number of any other kind is not a trust",
          "when": [
            {
              "column": "donor_status",
              "op": "equals",
              "value": "Trust"
            },
            {
              "column": "company_number_clean",
              "op": "not_null"
            }
          ],
          "value": "Company"
        }
      ]
    }
  ],
  "match_keys": [
    {
      "id": "k1",
      "name": "Company number",
      "track": "organisation",
      "tier": 1,
      "columns": [
        "company_number_clean"
      ],
      "allow_null": false,
      "applies_when": "always",
      "guards": {
        "blocklists": [
          "placeholder_numbers"
        ],
        "max_distinct": {
          "column": "name_core",
          "count": 1
        }
      },
      "on_guard_fail": "review"
    },
    {
      "id": "k2",
      "name": "Name and postcode",
      "track": "organisation",
      "tier": 2,
      "columns": [
        "name_core",
        "postcode_clean"
      ],
      "allow_null": false,
      "applies_when": "always",
      "guards": {},
      "on_guard_fail": "review"
    },
    {
      "id": "k3",
      "name": "Exact cleaned name",
      "track": "person",
      "tier": 1,
      "columns": [
        "name_clean"
      ],
      "allow_null": false,
      "applies_when": "always",
      "guards": {
        "max_group_size": 60
      },
      "on_guard_fail": "review"
    },
    {
      "id": "k4",
      "name": "Trade union: same name",
      "description": "A trade union is settled by its status and its name (D13c), so unions sharing a cleaned core name are the same union. The condition keeps the key away from every other kind of organisation, where a shared name settles nothing. The size guard sits in the gap the data leaves.",
      "track": "organisation",
      "tier": 3,
      "when": [
        {
          "column": "donor_status_std",
          "op": "equals",
          "value": "Trade Union"
        }
      ],
      "columns": [
        "name_core"
      ],
      "allow_null": false,
      "applies_when": "always",
      "guards": {
        "max_group_size": 200
