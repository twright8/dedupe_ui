{
  "schema": 1,
  "token_lists": {
    "person_titles": {
      "description": "Titles that come before a person's name. A title at the start of an ambiguous donor's name is the strongest sign the donor is a person.",
      "tokens": [
        "MR",
        "MRS",
        "MS",
        "MISS",
        "MX",
        "DR",
        "SIR",
        "LORD",
        "LADY",
        "DAME",
        "PROF",
        "PROFESSOR",
        "REV",
        "REVD",
        "CLLR",
        "COUNCILLOR",
        "BARONESS",
        "BARON",
        "VISCOUNT",
        "EARL",
        "HON",
        "RT HON",
        "THE RT HON",
        "CAPT",
        "MAJOR",
        "COL"
      ]
    },
    "post_nominals": {
      "description": "Letters that come after a person's name. MS is deliberately absent: it clashes with the title, and the title is far commoner in this sheet.",
      "tokens": [
        "MP",
        "MSP",
        "AM",
        "MEP",
        "QC",
        "KC",
        "OBE",
        "MBE",
        "CBE",
        "KBE",
        "DBE",
        "JP",
        "DL",
        "PC"
      ]
    },
    "legal_forms": {
      "description": "Legal forms stripped from the end of an organisation name to give name_core. Split, do not delete: the form is kept in legal_form so Ltd-versus-PLC stays answerable at decision time.",
      "tokens": [
        "LTD",
        "LIMITED",
        "PLC",
        "LLP",
        "LP",
        "CIC",
        "CIO",
        "INC",
        "LLC",
        "GMBH",
        "SA",
        "BV",
        "NV",
        "AG",
        "CO",
        "COMPANY",
        "AND CO"
      ]
    },
    "org_words": {
      "description": "Words that mark an organisation without being a legal form. Used to sort ambiguous donors into the organisation track; never stripped from a name.",
      "tokens": [
        "CLUB",
        "ASSOCIATION",
        "UNION",
        "TRUST",
        "SOCIETY",
        "COUNCIL",
        "PARTY",
        "COMMITTEE",
        "GROUP",
        "FUND",
        "HOLDINGS",
        "BRANCH",
        "FOUNDATION",
        "FEDERATION",
        "INSTITUTE",
        "PARTNERS",
        "SERVICES"
      ]
    },
    "leading_articles": {
      "description": "Articles dropped from the start of an organisation name, so 'The Smith Trust' and 'Smith Trust' are one name.",
      "tokens": [
        "THE"
      ]
    },
    "null_values": {
      "description": "Spellings of 'no value' that arrive as text. A name equal to one of these is missing, not a name.",
      "tokens": [
        "N/A",
        "NA",
        "NONE",
        "UNKNOWN",
        "NOT KNOWN",
        "-",
        "."
      ]
    },
    "placeholder_numbers": {
      "description": "Company numbers that are typed in when the real one is unknown. They repeat across unrelated donors, so a match key must ignore them.",
      "tokens": [
        "00000000",
        "00000001",
        "12345678",
        "00123456",
        "99999999"
      ]
    },
    "placeholder_postcodes": {
      "description": "Postcodes that stand for 'not known' rather than a place. Left in, one of them would put hundreds of unrelated organisations in one block and read as an address agreement.",
      "tokens": [
        "ZZ0 0ZZ",
        "ZZ1 1ZZ",
        "XX0 0XX",
        "XX1 1XX",
        "AA0 0AA",
        "AA1 1AA"
      ],
      "_measured": "ZZ0 0ZZ is on 729 donation rows and 730 records; the rest are typed placeholders. ZZ0 0ZZ alone would block 412 organisation units together."
    }
  },
