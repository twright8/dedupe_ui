# Example for /etc/dedupe_donations.env
#
# This file holds settings for the donations reconciliation instance.
# Copy it to the server, fill in the two secrets, and put it at
# /etc/dedupe_donations.env with these permissions:
#
#   sudo install -m 0640 -o root -g dedupe_app \
#     dedupe_donations.env /etc/dedupe_donations.env
#
# Mode 0640 means root can read and write it, the dedupe_app user can read it,
# and nobody else can read it at all.
#
# Format rules: one NAME=value per line. No spaces around the "=".
# No quotes unless the value really contains quotes. No shell tricks.
#
# THIS FILE CONTAINS NO REAL SECRETS. Do not commit a filled-in copy.


# ---------------------------------------------------------------------------
# The two secrets
# ---------------------------------------------------------------------------

# The password every user types on the login screen.
# It must be the SAME in all three files: /etc/roe_ui.env,
# /etc/dedupe_donations.env and /etc/dedupe_psc.env.
# If the three differ, a user has to log in three times.
SITE_PASSWORD=replace-with-the-shared-site-password

# The key that signs the login cookie.
# It must be the SAME in all three files, for the same reason.
# It must also stay the same forever. If it changes, everyone is logged out.
#
# Generate one strong key with this command, and paste the result here:
#
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# That prints 64 random characters. Use one key for all three files.
SECRET_KEY=replace-with-64-random-characters


# ---------------------------------------------------------------------------
# What this instance is
# ---------------------------------------------------------------------------

# Which profile this process runs. "donations" or "psc".
# The profile decides the column mapping, the default rules and the title.
PROFILE=donations

# The URL prefix this instance is served under.
# Caddy forwards /donations/... to this process without removing the prefix.
# The app removes it itself. So this must match the Caddy route exactly.
BASE_PATH=/donations

# Where this instance keeps everything it owns: the SQLite database
# (linkage.db), uploaded files, run outputs, trained models, and the
# reference tables. Must be writable by the dedupe_app user.
DATA_DIR=/var/lib/dedupe_ui/donations


# ---------------------------------------------------------------------------
# Resource limits
# ---------------------------------------------------------------------------

# How much memory DuckDB (the engine behind Splink) may use before it starts
# spilling to disk. This is the soft brake. The hard brake is MemoryMax=6G in
# dedupe_donations.service. Keep this value below MemoryMax, so spilling gets
# a chance to work before systemd kills the process.
# Donations is the small dataset: about 52,000 donors.
SPLINK_MEMORY_LIMIT=4GB

# Where temporary files go, including anything DuckDB spills to disk.
# Pointed at the data directory on purpose: /tmp is small and shared, and a
# large spill there could fill the disk for every other program on the server.
TMPDIR=/var/lib/dedupe_ui/donations/tmp


# ---------------------------------------------------------------------------
# Tuning knobs. All optional. The defaults are fine for donations.
# Uncomment one only if you are changing it on purpose.
# ---------------------------------------------------------------------------

# How many rows the cleaning stage handles in one batch. Default 500000.
# Lower it if cleaning ever runs out of memory.
#CLEAN_BATCH_ROWS=500000

# PSC-only settings. They are read by the PSC profile and ignored here.
#PSC_QUICK_ROWS=200000
#PSC_DUCKDB_MEMORY=2GB
#PSC_DUCKDB_THREADS=2
